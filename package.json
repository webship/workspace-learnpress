{
  "name": "@webship.co/workspace-learnpress",
  "version": "1.0.0",
  "description": "LearnPress for Webship Workspace, on top of its WordPress plugin: the builder (`cmd-learnpress-project.sh`) in every sites folder, a site of courses with LearnPress's pages and roles, the default accounts (one per place in the courses), the sample courses (two free courses, their lessons, a quiz, an enrolment), the courses' tool (`cmd-tools-learnpress-courses.sh`), the LearnPress step pack wired into the testing setup next to the WordPress one, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-learnpress.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "learnpress",
    "label": "LearnPress",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "wordpress",
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-learnpress-project.sh",
        "commands/cmd-tools-learnpress-courses.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-learnpress.sh"
      ],
      "args": [
        "scripts/args/arg-learnpress.sh",
        "scripts/args/arg-learnpress-courses.sh"
      ],
      "machine": [
        "testing/courses.feature",
        "scripts/learning-site.php"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/learnpress-site-builder.md",
        "ai/agents/learnpress-tester.md"
      ],
      "skills": [
        "ai/skills/learnpress-scenarios"
      ],
      "commands": [
        "ai/commands/learnpress-test.md"
      ],
      "prompts": [
        "ai/prompts/learnpress-build-and-test.md",
        "ai/prompts/learnpress-quiz-round.md"
      ]
    },
    "features": [
      "features/learnpress.feature",
      "features/learnpress-runtimes.feature"
    ],
    "featuresSite": "cmd-learnpress-project.sh ci-learnpress --install --add-users --sample-course --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
